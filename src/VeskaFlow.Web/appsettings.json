{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": true
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "BookingPerMinute": 6,
    "ChatPerMinute": 12
  },
  "AiReceptionist": {
    "Model": "claude-haiku-5-5",
    "MonthlyConversations": 300,
    "MonthlyTokens": 4000000
  },
  "Booking": {
    "MaxActivePerCustomer": 2
  },
  "Trial": {
    "Days": 30,
    "ContactUrl": "https://veskacode.com/#contact"
  },
  "Signup": {
    "RequireEmailConfirmation": true,
    "RequireApproval": false
  },
  "Platform": {
    "AdminEmails": ""
  },
  "Email": {
    "From": "",
    "ResendApiKey": ""
  },
  "Proxy": {
    "TrustForwardedHeaders": false
  }
}
