{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": true
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "BookingPerMinute": 6
  },
  "Booking": {
    "MaxActivePerCustomer": 2
  },
  "Trial": {
    "Days": 30,
    "ContactUrl": "https://veskacode.com/#contact"
  },
  "Proxy": {
    "TrustForwardedHeaders": false
  }
}
