@page
@model VeskaFlow.Web.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = Text.ForgotTitle;
}
<div class="card">
    <h1>@Text.ForgotTitle</h1>
    @if (Model.Sent)
    {
        <div class="notice" role="status">@Text.ForgotSent</div>
        <p class="auth-alt"><a href="/Login">@Text.ResetBackToSignIn</a></p>
    }
    else
    {
        <p class="hint">@Text.ForgotHint</p>
        <form method="post" novalidate>
            @if (Model.Errors.Count > 0) { <div class="alert" role="alert">@Model.ErrorFor("form")</div> }
            <div class="field">
                <label for="Email">@Text.LabelEmail</label>
                <input type="email" id="Email" name="Email" value="@Model.Email" maxlength="120" autocomplete="username" required />
            </div>
            <partial name="_Captcha" />
            <button type="submit" class="primary">@Text.ForgotSend</button>
        </form>
        <p class="auth-alt"><a href="/Login">@Text.ResetBackToSignIn</a></p>
    }
</div>
