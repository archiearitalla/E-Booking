@page "/b/{slug}"
@model VeskaFlow.Web.Pages.Book.IndexModel
@{
    ViewData["Title"] = Model.Shop?.Name ?? Text.BookTitle;
    var shop = Model.Shop!;
    ViewData["Theme"] = shop.BrandColor;
    ViewData["Public"] = true;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    var stripDays = Math.Min(shop.HorizonDays + 1, 14);
}
<div class="book-shell">
<section class="hero-card">
    <div>
        @if (Model.LogoVersion is { } logoVersion) { <img class="shop-logo" src="/logo/@shop.Slug?v=@logoVersion" alt="" height="72" /> }
        <p class="hero-kicker">@Text.BookTitle</p>
        <h1>@shop.Name</h1>
    </div>
    @if (shop.AcceptingBookings && shop.Services.Count > 0)
    {
        <div class="hero-actions">
            <a class="hero-btn" href="#book">@Text.BookNow</a>
            @if (Model.ChatEnabled) { <a class="hero-btn hero-btn-alt" href="#chat">@Text.AiChatShort</a> }
        </div>
    }
</section>

<div class="card" id="book">
    @if (Model.Taken)
    {
        <div class="alert" role="alert">@Text.BookTaken</div>
    }

    @if (!shop.AcceptingBookings)
    {
        <p>@Text.TrialEndedPublic</p>
    }
    else if (shop.Services.Count == 0)
    {
        <p>@Text.BookNoServices</p>
    }
    else
    {
        <form method="get" asp-page="/Book/Index" asp-route-slug="@shop.Slug">
            <div class="field">
                <label for="serviceId">@Text.BookService</label>
                <select id="serviceId" name="serviceId" required>
                    <option value="" disabled selected="@(Model.ServiceId is null)">@Text.BookServicePlaceholder</option>
                    @foreach (var service in shop.Services)
                    {
                        <option value="@service.Id" selected="@(Model.ServiceId == service.Id)" data-other="@(service.IsOther ? "true" : "false")">@service.Name@(service.IsOther ? "" : " · " + DisplayFormat.Price(service.Price))</option>
                    }
                </select>
            </div>
            @if (shop.Services.Any(s => s.IsOther))
            {
                <div class="field" data-other-field>
                    <label for="serviceNote">@Text.OtherServiceLabel</label>
                    <input type="text" id="serviceNote" name="serviceNote" value="@Model.ServiceNote" maxlength="60"
                           aria-describedby="serviceNote-hint" />
                    <p class="hint" id="serviceNote-hint">@Text.OtherServiceHint</p>
                </div>
            }

            <fieldset class="field">
                <legend>@Industries.StaffLabel(shop.Industry)</legend>
                <div class="people">
                    <label class="choice person">
                        <input type="radio" name="staffId" value="" checked="@(Model.StaffId is null)" />
                        <span class="avatar" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </span>
                        <span><strong>@Text.BookStaffAny</strong></span>
                    </label>
                    @foreach (var staff in shop.Staff)
                    {
                        <label class="choice person">
                            <input type="radio" name="staffId" value="@staff.Id" checked="@(Model.StaffId == staff.Id)" />
                            <span class="avatar" aria-hidden="true">@staff.Name.Trim()[..1].ToUpperInvariant()</span>
                            <span><strong>@staff.Name</strong></span>
                        </label>
                    }
                </div>
            </fieldset>

            <fieldset class="field">
                <legend>@Text.BookDate</legend>
                <div class="datestrip">
                    @for (var i = 0; i < stripDays; i++)
                    {
                        var day = shop.Today.AddDays(i);
                        if (Model.ClosedDates.Contains(day)) { continue; } // closed days are not offered
                        <label class="daychip">
                            <input type="radio" name="date" value="@DisplayFormat.DateParam(day)" checked="@(Model.SelectedDate == day)" />
                            <small>@day.ToString("ddd", invariant)</small>
                            <span>@day.Day</span>
                            <small>@day.ToString("MMM", invariant)</small>
                        </label>
                    }
                </div>
                <details class="other-date">
                    <summary>@Text.BookAnotherDate</summary>
                    <input type="date" id="other" name="other" aria-label="@Text.BookAnotherDate"
                           min="@DisplayFormat.DateParam(shop.Today)" max="@DisplayFormat.DateParam(shop.Today.AddDays(shop.HorizonDays))" />
                </details>
            </fieldset>

            <button type="submit" class="primary">@Text.BookShowTimes</button>
        </form>
    }
</div>

@if (Model.ChatEnabled)
{
    @* Hidden until chat.js runs: without JavaScript the form above is the way to book. *@
    <section class="card" id="chat" hidden aria-labelledby="chat-title"
             data-working="@Text.AiChatWorking" data-network="@Text.AiChatNetwork" data-unavailable="@Text.AiChatUnavailable">
        <h2 id="chat-title">@Text.AiChatTitle</h2>
        <p class="hint">@Text.AiChatIntro</p>
        <p class="hint">@Text.AiChatNotice <a href="/Privacy">@Text.AiChatNoticeLink</a></p>
        <div class="chat-log" id="chat-log" role="log" aria-live="polite">
            <p class="chat-msg bot">@Text.AiChatGreeting</p>
        </div>
        <form class="chat-form" method="post" asp-page="/Book/Chat" asp-route-slug="@shop.Slug" autocomplete="off">
            <input type="hidden" name="chatId" value="" />
            <label for="chat-input" class="sr-only">@Text.AiChatPlaceholder</label>
            <input type="text" id="chat-input" name="message" maxlength="500" placeholder="@Text.AiChatPlaceholder" required />
            <button type="submit" class="primary">@Text.AiChatSend</button>
        </form>
    </section>
    <script src="~/js/chat.js" defer asp-append-version="true"></script>
}

@if (Model.Searched)
{
    <div class="card" id="times" aria-live="polite">
        <h2>@Text.BookAvailableTimes @Model.DateText</h2>
        @if (Model.Notice is not null)
        {
            <p>@Model.Notice</p>
        }
        else if (Model.Times.Count == 0)
        {
            <p>@Text.BookNoTimes</p>
        }
        else
        {
            <ul class="slots">
                @foreach (var start in Model.Times)
                {
                    <li>
                        <a class="slot" asp-page="/Book/Details" asp-route-slug="@shop.Slug"
                           asp-route-serviceId="@Model.ServiceId" asp-route-staffId="@Model.StaffId" asp-route-serviceNote="@Model.ServiceNote"
                           asp-route-start="@DisplayFormat.StartParam(start)">@DisplayFormat.Time(start, shop.TimeZone)</a>
                    </li>
                }
            </ul>
        }
    </div>
}
else if (shop.Services.Count > 0)
{
    @* Wide screens only: the empty right-hand side says how booking works instead of staying blank. It comes before the
       hint so it sits beside the form. *@
    <div class="card book-steps">
        <h2>@Text.BookStepsTitle</h2>
        <ol>
            <li>@Text.BookStep1</li>
            <li>@Text.BookStep2</li>
            <li>@Text.BookStep3</li>
        </ol>
        <p class="hint">@Text.BookStepsNote</p>
    </div>
    <p class="muted">@Text.BookPickService</p>
}
</div>
