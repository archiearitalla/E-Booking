@inject VeskaFlow.Web.Services.FollowUpService FollowUps
@inject VeskaFlow.Web.Services.AccountControlService PlatformAccounts
@inject VeskaFlow.Web.Services.PaymentService PaymentsForOwner
@{
    Layout = "_Layout";
    var path = Context.Request.Path.Value ?? "";
    // Follow-ups that need a message soon: shown as a strip here and in the header bell (the layout reuses this result).
    var scopeStaff = Context.Items.TryGetValue(VeskaFlow.Web.Services.AdminRoles.ScopeItemKey, out var sc) ? sc as Guid? : null;
    var alert = User.BusinessId() is { } businessId ? await FollowUps.AlertAsync(businessId, default, scopeStaff) : new VeskaFlow.Web.Services.FollowUpAlert(0, 0);
    Context.Items[VeskaFlow.Web.Services.FollowUpAlert.ItemKey] = alert;
    // The platform owner is told here, on every back-office page, when a client's subscription is ending (or has just ended).
    var isPlatformOwner = !path.StartsWith("/Platform", StringComparison.OrdinalIgnoreCase) && await PlatformAccounts.IsPlatformAdminAsync(User.UserId());
    var expiring = isPlatformOwner ? await PlatformAccounts.CountExpiringShopsAsync() : 0;
    var waitingPayments = isPlatformOwner ? await PaymentsForOwner.PendingCountAsync() : 0;
    var onFollowUps = path.StartsWith("/Admin/FollowUps", StringComparison.OrdinalIgnoreCase);
    var onReminders = path.StartsWith("/Admin/Reminders", StringComparison.OrdinalIgnoreCase);
    var level = Context.Items.TryGetValue(AdminRoles.LevelItemKey, out var lv) && lv is AdminLevel l ? l : AdminLevel.Staff;
    (string Href, string Label, AdminLevel Minimum)[] allItems =
    [
        ("/Admin", Text.AdminNavBookings, AdminLevel.Staff),
        ("/Admin/WalkIn", Text.AdminNavWalkIn, AdminLevel.Staff),
        ("/Admin/Reminders", Text.AdminNavReminders, AdminLevel.Staff),
        ("/Admin/Customers", Text.AdminNavCustomers, AdminLevel.Manager),
        ("/Admin/Reports", Text.AdminNavReports, AdminLevel.Manager),
        ("/Admin/FollowUps", Text.AdminNavFollowUps, AdminLevel.Staff),
        ("/Admin/Services", Text.AdminNavServices, AdminLevel.Manager),
        ("/Admin/Staff", Text.AdminNavStaff, AdminLevel.Manager),
        ("/Admin/Closures", Text.AdminNavClosures, AdminLevel.Manager),
        ("/Admin/Team", Text.AdminNavTeam, AdminLevel.Owner),
        ("/Admin/Billing", Text.BillingPageTitle, AdminLevel.Owner),
        ("/Admin/Settings", Text.AdminNavSettings, AdminLevel.Owner),
        ("/Admin/Promo", Text.AdminNavPromo, AdminLevel.Owner),
        ("/Admin/Audit", Text.AdminNavAudit, AdminLevel.Manager),
        ("/Admin/Account", Text.AdminNavAccount, AdminLevel.Staff),
        ("/Admin/Help", Text.AdminNavHelp, AdminLevel.Staff),
        ("/Admin/About", Text.AdminNavAbout, AdminLevel.Staff),
    ];
    var items = allItems.Where(i => level >= i.Minimum).Select(i => (i.Href, i.Label)).ToArray();
    bool Current(string href) => href == "/Admin"
        ? path.TrimEnd('/').Equals("/Admin", StringComparison.OrdinalIgnoreCase)
        : path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
}
<div class="admin-shell">
<nav class="subnav" aria-label="@Text.AdminNavLabel">
    <ul>
        @foreach (var (href, label) in items)
        {
            <li><a href="@href" aria-current="@(Current(href) ? "page" : null)">@label</a></li>
        }
    </ul>
</nav>

<div class="admin-main">
@if (waitingPayments > 0)
{
    <div class="notice" role="status">
        <a href="/Platform/Payments">@Text.PaymentsAlert(waitingPayments) @Text.PaymentsAlertView</a>
    </div>
}

@if (expiring > 0)
{
    <div class="notice" role="status">
        <a href="/Platform?expiring=true">@Text.ExpiryAlert(expiring) @Text.ExpiryAlertView</a>
    </div>
}

@if (alert.Reminders > 0 && !onReminders)
{
    <div class="notice" role="status">
        <a href="/Admin/Reminders">@Text.ReminderAlertText(alert.Reminders)</a>
    </div>
}

@if (alert.Total > 0 && !onFollowUps)
{
    <div class="notice" role="status">
        <a href="/Admin/FollowUps">@Text.FollowUpAlertText(alert.Overdue, alert.Soon, alert.Days)</a>
    </div>
}

@if (Model is VeskaFlow.Web.Pages.Admin.AdminPageModel admin)
{
    @if (!string.IsNullOrEmpty(admin.Success))
    {
        <div class="notice" role="status">@admin.Success</div>
    }
    @if (!string.IsNullOrEmpty(admin.Failure))
    {
        <div class="alert" role="alert">@admin.Failure</div>
    }
}

@RenderBody()
</div>
</div>
@section Head {
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0a1116" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="VeskaFlow" />
}
