<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @Text.AppName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <script src="~/js/site.js" defer asp-append-version="true"></script>
</head>
<body data-theme="@VeskaFlow.Web.Services.BrandColors.Normalize(ViewData["Theme"] as string)" data-confirm-yes="@Text.ConfirmYes" data-confirm-no="@Text.ConfirmNo">
    <a class="skip-link" href="#main">@Text.SkipToContent</a>
    <header class="site-header">
        <a class="brand" href="/">@Text.AppName</a>
        <nav aria-label="Main">
            @if (ViewData["Public"] is true)
            {
                @* Customer pages: never show the owner's Dashboard or Sign out, even on a device where the owner is signed in. *@
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                // Follow-ups that need a message soon. Only the back-office pages load this (see _AdminLayout).
                var followUpAlert = Context.Items.TryGetValue(VeskaFlow.Web.Services.FollowUpAlert.ItemKey, out var cachedAlert) && cachedAlert is VeskaFlow.Web.Services.FollowUpAlert known
                    ? known
                    : new VeskaFlow.Web.Services.FollowUpAlert(0, 0);
                var trialEndsNow = User.TrialEndsForBell(Context.Items);
                @if (trialEndsNow is not null || followUpAlert.Total > 0)
                {
                    var daysLeft = trialEndsNow is { } trialEnds ? (int)Math.Ceiling((trialEnds - DateTime.UtcNow).TotalDays) : int.MaxValue;
                    var badgeText = followUpAlert.Total > 0 ? followUpAlert.Total.ToString() : daysLeft > 0 ? daysLeft.ToString() : "!";
                    var badgeEnd = followUpAlert.Total > 0 || daysLeft <= 0;
                    <details class="bell">
                        <summary aria-label="@Text.NotificationsLabel">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                            <span class="bell-badge@(badgeEnd ? " end" : "")">@badgeText</span>
                        </summary>
                        <div class="bell-panel" role="status">
                            @if (followUpAlert.Total > 0)
                            {
                                <strong>@Text.AdminNavFollowUps</strong>
                                <p>@Text.FollowUpAlertText(followUpAlert.Overdue, followUpAlert.Soon, followUpAlert.Days) <a href="/Admin/FollowUps">@Text.FollowUpOpen</a></p>
                            }
                            @if (trialEndsNow is not null)
                            {
                                <strong>@Text.TrialTitle</strong>
                                <p>@(daysLeft > 0 ? string.Format(Text.TrialBanner, daysLeft) : Text.TrialEndedBanner)</p>
                            }
                        </div>
                    </details>
                }
                <a href="/Admin">@Text.NavDashboard</a>
                <form method="post" asp-page="/Logout" class="inline">
                    <button type="submit" class="link">@Text.NavSignOut</button>
                </form>
            }
            else
            {
                <a href="/Login">@Text.NavSignIn</a>
                <a href="/Register">@Text.NavRegister</a>
            }
        </nav>
    </header>
    <main class="container" id="main" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <a href="/Terms">@Text.TermsLink</a> &middot; <a href="/Privacy">@Text.PrivacyLink</a><br />
        @Text.AppName v@(AppInfo.Version)
    </footer>
</body>
</html>
