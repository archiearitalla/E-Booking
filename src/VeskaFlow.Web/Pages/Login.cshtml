@page
@model VeskaFlow.Web.Pages.LoginModel
@{
    ViewData["Title"] = Text.LoginTitle;
}
<div class="card">
    <h1>@Text.LoginTitle</h1>
    @if (Model.Disabled) { <div class="alert" role="alert">@Text.ShopDisabled</div> }
    @if (Model.Confirmed) { <div class="notice" role="status">@Text.ConfirmDone</div> }
    @if (Model.Pending) { <div class="notice" role="status">@Text.SignupPending</div> }
    <form method="post" novalidate>
        @if (Model.Errors.Count > 0)
        {
            <div class="alert" role="alert">@Model.ErrorFor("form")</div>
        }
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

        <div class="field">
            <label for="Email">@Text.LabelEmail</label>
            <input type="email" id="Email" name="Input.Email" value="@Model.Input.Email" maxlength="120" autocomplete="username" />
        </div>

        <div class="field">
            <label for="Password">@Text.LabelPassword</label>
            <input type="password" id="Password" name="Input.Password" maxlength="256" autocomplete="current-password" />
        </div>

        <button type="submit" class="primary">@Text.ButtonSignIn</button>
    </form>
    @if (Model.NeedsConfirmation)
    {
        <form method="post" asp-page="/CheckEmail" asp-page-handler="Resend" class="resend-form">
            <input type="hidden" name="email" value="@Model.Input.Email" />
            <button type="submit" class="secondary">@Text.ConfirmResend</button>
        </form>
    }
    <p>@Text.LoginNew <a href="/Register">@Text.NavRegister</a></p>
</div>
