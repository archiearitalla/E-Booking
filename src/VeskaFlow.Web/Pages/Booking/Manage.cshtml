@page "/booking/{token}"
@using VeskaFlow.Core.Domain
@model VeskaFlow.Web.Pages.Booking.ManageModel
@{
    ViewData["Title"] = Text.ManageTitle;
    var d = Model.Details!;
    var b = d.Booking;
    ViewData["Theme"] = d.BrandColor;
    ViewData["Public"] = true;
}
@section Head {
    <meta name="robots" content="noindex" />
}
<div class="card">
    <h1>@Text.ManageTitle</h1>

    @if (Model.JustBooked && b.Status == VeskaFlow.Core.Domain.BookingStatus.Confirmed)
    {
        <div class="notice" role="status">@Text.ManageConfirmed</div>
    }
    @if (b.Status == VeskaFlow.Core.Domain.BookingStatus.Cancelled)
    {
        <div class="notice" role="status">@Text.ManageCancelled</div>
    }
    @if (b.Status == VeskaFlow.Core.Domain.BookingStatus.Held && d.HoldExpiresAtUtc is { } heldUntil)
    {
        <div class="deposit-due" role="status"><p>@Text.ManageHeld(DisplayFormat.Time(heldUntil, d.TimeZone))</p></div>
    }
    @if (Model.Notice is not null)
    {
        <div class="notice" role="status">@Model.Notice</div>
    }
    @if (Model.Message is not null)
    {
        <div class="alert" role="alert">@Model.Message</div>
    }

    <dl class="facts">
        <dt>@Text.ManageShop</dt><dd>@d.BusinessName</dd>
        <dt>@Text.ManageService</dt><dd>@b.ServiceName</dd>
        <dt>@Text.ManageWith</dt><dd>@b.StaffName</dd>
        <dt>@Text.ManageWhen</dt><dd>@DisplayFormat.Date(b.StartsAtUtc, d.TimeZone), @DisplayFormat.Time(b.StartsAtUtc, d.TimeZone)</dd>
        <dt>@Text.ManageWho</dt><dd>@d.CustomerName</dd>
        <dt>@Text.ManagePrice</dt><dd><partial name="_PriceLine" model="new PriceLineModel(b.Price, b.RegularPrice, b.DiscountPercent)" />@if (b.Status != VeskaFlow.Core.Domain.BookingStatus.Completed) { <text> &middot; @Text.BookPayOnSite</text> }</dd>
        @if (b.Status == VeskaFlow.Core.Domain.BookingStatus.Completed)
        {
            @foreach (var extra in d.Extras ?? [])
            {
                <dt>@Text.ManageAlsoDone</dt><dd>@extra.Name &middot; <partial name="_PriceLine" model="new PriceLineModel(extra.Price, extra.RegularPrice, extra.DiscountPercent)" /></dd>
            }
            <dt>@Text.ManageTotalPaid</dt><dd><strong>@DisplayFormat.Price(b.Total)</strong></dd>
        }
        <dt>@Text.ManageStatus</dt><dd><span class="badge">@b.Status.Label()</span></dd>
    </dl>

    @if (d.Deposit > 0 && b.Status == VeskaFlow.Core.Domain.BookingStatus.Confirmed)
    {
        <div class="@(d.DepositReceived ? "notice" : "deposit-due")" role="status">
            @if (d.DepositReceived)
            {
                <p>@string.Format(Text.ManageDepositReceived, DisplayFormat.Price(d.Deposit))</p>
            }
            else
            {
                <h2>@string.Format(Text.ManageDepositDue, DisplayFormat.Price(d.Deposit))</h2>
                @if (!string.IsNullOrWhiteSpace(d.PayInstructions)) { <p class="pay-instructions">@d.PayInstructions</p> }
                <p class="hint">@Text.ManageDepositHow</p>
            }
        </div>
    }

    @if (b.Status != VeskaFlow.Core.Domain.BookingStatus.Cancelled)
    {
        <div class="save-booking">
            <h2>@Text.ManageSaveTitle</h2>
            <p class="hint">@Text.ManageSaveHint</p>
            <div class="field">
                <label for="manage-link">@Text.ManageLinkLabel</label>
                <input type="text" id="manage-link" readonly value="@Model.ManageUrl(b.ManageToken)" />
            </div>
            <div class="actions">
                <button type="button" class="secondary" data-copy="manage-link" data-copied="@Text.FollowUpCopied">@Text.ManageCopyLink</button>
                <a class="button" href="/booking/@b.ManageToken?handler=Calendar">@Text.ManageAddToCalendar</a>
            </div>
        </div>
    }

    @if (d.CanMove)
    {
        <p class="hint">@string.Format(Text.ManageMoveHint, d.CancelCutoffHours)</p>
        <p><a class="button" href="/booking/@b.ManageToken/move">@Text.ManageMoveButton</a></p>
    }
    @if (d.CanCancel)
    {
        <form method="post" asp-page-handler="Cancel" asp-route-token="@b.ManageToken">
            <p class="hint">@string.Format(Text.ManageCancelHint, d.CancelCutoffHours)</p>
            <button type="submit" class="danger once" data-confirm="@Text.ConfirmCancelCustomer">@Text.ManageCancelButton</button>
        </form>
    }
    else if (d.CancelRefusal is not null)
    {
        <p class="hint">@d.CancelRefusal</p>
    }
    else
    {
        <p class="hint">@Text.ManageClosed</p>
    }
</div>
