@page "/Admin/AfterVisit/{id:guid}"
@model VeskaFlow.Web.Pages.Admin.AfterVisitModel
@{
    ViewData["Title"] = Text.AfterVisitTitle;
    var b = Model.Booking!;
    var fuValue = (b.FollowUpOn ?? b.SuggestedFollowUp) is { } fuDate ? DisplayFormat.DateParam(fuDate) : "";
}
<h1>@Text.AfterVisitTitle</h1>

<div class="card">
    <dl class="facts">
        <dt>@Text.ManageWho</dt><dd>@b.CustomerName</dd>
        <dt>@Text.ManageService</dt><dd>@b.ServiceName &middot; @DisplayFormat.Time(b.StartsAtUtc, Model.TimeZone)</dd>
    </dl>
    <p><a href="/Admin/History/@b.CustomerId">@Text.HistoryLink</a></p>
</div>

<div class="card">
    <h2>@Text.ExtraTitle</h2>
    <p class="hint">@Text.ExtraHint</p>
    <ul class="plain-list">
        <li><strong>@b.ServiceName</strong> <span class="muted">(@Text.ExtraBooked)</span> &middot; <partial name="_PriceLine" model="new PriceLineModel(b.Price, b.RegularPrice, b.DiscountPercent)" /></li>
        @foreach (var line in b.ExtraLines)
        {
            <li>
                <strong>@line.Name</strong> &middot; <partial name="_PriceLine" model="new PriceLineModel(line.Price, line.RegularPrice, line.DiscountPercent)" />
                <form method="post" asp-page-handler="RemoveService" asp-route-id="@b.Id" class="inline-form">
                    <input type="hidden" name="extraId" value="@line.Id" />
                    <button type="submit" class="link danger" data-confirm="@Text.ExtraRemoveAsk">@Text.ExtraRemove<span class="sr-only"> @line.Name</span></button>
                </form>
            </li>
        }
    </ul>
    <p><strong>@Text.ExtraItemsTotal:</strong> @DisplayFormat.Price(b.ItemsTotal)</p>

    @if (b.ExtraLines.Count < BookingExtraService.MaxExtras)
    {
        <form method="post" asp-page-handler="AddService" asp-route-id="@b.Id">
            <h3>@Text.ExtraAdd</h3>
            <div class="field">
                <label for="extraService">@Text.ExtraChoose</label>
                <select id="extraService" name="serviceId" required>
                    @foreach (var s in Model.Services)
                    {
                        <option value="@s.Id">@s.Name@(s.IsOther ? "" : " · " + DisplayFormat.Price(s.Price))</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="extraNote">@Text.ExtraNoteLabel</label>
                <input type="text" id="extraNote" name="note" maxlength="60" />
            </div>
            <div class="field">
                <label for="extraPrice">@Text.ExtraPriceLabel</label>
                <input type="text" id="extraPrice" name="price" inputmode="decimal" maxlength="12" />
            </div>
            <button type="submit" class="secondary">@Text.ExtraAddButton</button>
        </form>
    }
</div>

<div class="card">
    @if (Model.AllowManualTotal)
    {
        <form method="post" asp-page-handler="Payment" asp-route-id="@b.Id">
            <h2>@Text.AfterVisitPaymentTitle</h2>
            <p class="hint">@Text.AfterVisitPaymentHint</p>
            <dl class="facts">
                <dt>@Text.AfterVisitPaymentQuoted</dt><dd>@DisplayFormat.Price(b.ItemsTotal)</dd>
            </dl>
            <div class="field">
                <label for="paidAmount">@Text.AfterVisitPaymentLabel</label>
                <input type="text" id="paidAmount" name="paidAmount" inputmode="decimal" maxlength="14"
                       value="@b.Amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
            </div>
            <button type="submit" class="primary" data-save data-confirm="@Text.ConfirmSaveRecord">@Text.AfterVisitPaymentSave</button>
        </form>
    }
    else
    {
        @* The shop does not allow a typed total: it is the price of the services, shown and not editable. *@
        <h2>@Text.AfterVisitPaymentTitle</h2>
        <p class="hint">@Text.PaymentFixedHint</p>
        <dl class="facts">
            <dt>@Text.AfterVisitPaymentTitle</dt><dd><strong id="paymentFixed">@DisplayFormat.Price(b.Amount)</strong></dd>
        </dl>
        @if (b.PaidAmount is not null)
        {
            <form method="post" asp-page-handler="Payment" asp-route-id="@b.Id">
                <p class="hint">@Text.PaymentEnteredBefore</p>
                <input type="hidden" name="paidAmount" value="" />
                <button type="submit" class="secondary" data-confirm="@Text.ConfirmSaveRecord">@Text.PaymentBackToItems</button>
            </form>
        }
    }
</div>

<div class="card">
    <form method="post" asp-page-handler="Notes" asp-route-id="@b.Id">
        <h2>@Text.VisitNotesTitle</h2>
        <p class="hint">@Text.VisitNotesHint</p>
        <div class="field">
            <label for="visitNotes">@Text.VisitNotesLabel</label>
            <textarea id="visitNotes" name="visitNotes" rows="6" maxlength="4000">@b.VisitNotes</textarea>
        </div>
        <button type="submit" class="primary" data-save data-confirm="@Text.ConfirmSaveRecord">@Text.VisitNotesSave</button>
    </form>
</div>

<div class="card">
    <form method="post" asp-page-handler="FollowUp" asp-route-id="@b.Id" class="followup-form">
        <h2>@Text.FollowUpTitle</h2>
        @if (b.FollowUpOn is null && b.SuggestedFollowUp is not null) { <p class="hint">@Text.FollowUpSuggested</p> }
        <div class="field">
            <label for="fu">@Text.FollowUpDate</label>
            <input type="date" id="fu" name="followUpOn" value="@fuValue" />
        </div>
        <div class="field">
            <label for="fus">@Text.FollowUpForService</label>
            <select id="fus" name="followUpServiceId">
                <option value="">@Text.FollowUpServiceSame (@b.ServiceName)</option>
                @foreach (var s in Model.Services.Where(s => s.Name != b.ServiceName))
                {
                    <option value="@s.Id" selected="@(b.FollowUpService == s.Name)">@s.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="fun">@Text.FollowUpNote</label>
            <input type="text" id="fun" name="followUpNote" value="@b.FollowUpNote" maxlength="200" />
        </div>
        <div class="actions">
            <button type="submit" class="primary" data-save data-confirm="@Text.ConfirmSaveFollowUp">@Text.FollowUpSave</button>
            @if (b.FollowUpOn is not null) { <button type="submit" name="clear" value="1" class="secondary" data-confirm="@Text.ConfirmRemoveFollowUp">@Text.FollowUpRemove</button> }
        </div>
    </form>
</div>

<div class="card">
    <h2>@Text.AfterVisitSendTitle</h2>
    <p class="hint">@Text.AfterVisitHint</p>
    @await Html.PartialAsync("_SendMessage", new VeskaFlow.Web.Pages.SendMessageModel(
        "t" + b.Id.ToString("N"), Model.ThankYou, b.CustomerPhone, b.CustomerEmail, Text.ThankYouSubject(Model.ShopName),
        $"/Admin?handler=Contact&id={b.Id}"))
    @if (b.FollowUpOn is null) { <p class="hint">@Text.AfterVisitMessageHint</p> }
</div>

<p><a class="button secondary" href="@Model.DayLink">@Text.AfterVisitBack</a></p>
