@page
@model VeskaFlow.Web.Pages.Admin.AboutModel
@{
    ViewData["Title"] = Text.AdminNavAbout;
}
<h1>@Text.AdminNavAbout</h1>
<div class="card">
    <dl class="facts">
        <dt>@Text.AboutSignedInAs</dt><dd>@User.DisplayName()</dd>
        <dt>@Text.AboutRole</dt><dd><span class="badge" title="@Text.AdminRoleTitle">@User.Role()</span></dd>
        <dt>@Text.AboutApp</dt><dd>@AppInfo.Name</dd>
        <dt>@Text.AboutVersion</dt><dd>@AppInfo.Version</dd>
        <dt>@Text.AboutBuild</dt><dd>@AppInfo.Build</dd>
        <dt>@Text.AboutRuntime</dt><dd>@Model.Runtime</dd>
        <dt>@Text.AboutEnvironment</dt><dd>@Model.EnvironmentName</dd>
    </dl>
</div>

<div class="card">
    <h2>@Text.InstallTitle</h2>
    <p class="hint">@Text.InstallHint</p>
    <ul class="plain-list">
        <li><strong>@Text.InstallAndroid</strong> @Text.InstallAndroidSteps</li>
        <li><strong>@Text.InstallIphone</strong> @Text.InstallIphoneSteps</li>
    </ul>
</div>

@if (Model.AccessEndsUtc is { } accessEnds)
{
    <div class="card">
        <h2>@Text.BillingTitle</h2>
        <dl class="facts">
            <dt>@Text.BillingAccessEnds</dt><dd>@DisplayFormat.Date(accessEnds, Model.TimeZone)</dd>
            @if (Model.PayQrVersion is null && Model.Billing.Price.Length > 0) { <dt>@Text.BillingPriceLabel</dt><dd>@Model.Billing.Price</dd> }
            @if (Model.PayQrVersion is null && Model.Billing.PayTo.Length > 0) { <dt>@Text.BillingPayToLabel</dt><dd>@Model.Billing.PayTo</dd> }
        </dl>
        @if (Model.PayQrVersion is { } qrVersion) { <partial name="_PayQr" model="qrVersion" /> }
        @if (Model.Billing.HasDetails) { <p class="hint">@(Model.Billing.Note.Length > 0 ? Model.Billing.Note : Text.BillingProof)</p> }
        @if (Model.Billing.ContactUrl.Length > 0)
        {
            <p><a class="button" href="@Model.Billing.ContactUrl" target="_blank" rel="noopener">@Text.BillingSendProof</a></p>
        }
    </div>
}
