@page
@model VeskaFlow.Web.Pages.Admin.Staff.IndexModel
@{
    ViewData["Title"] = Text.AdminNavStaff;
}
<h1>@Text.AdminNavStaff</h1>
<partial name="_HelpLink" model="@("staff")" />
<p><a class="button" href="/Admin/Staff/Edit">@Text.StaffAdd</a></p>
<p class="hint">@string.Format(Text.StaffPlanNote, Model.Plan, PlanLimits.MaxStaff(Model.Plan, Model.InTrial, Model.ExtraStaff))</p>
@if (Model.Plan == "PRO" || Model.InTrial)
{
    <p class="hint">@string.Format(Text.StaffIncludedNote, PlanLimits.IncludedStaff, Model.ExtraStaff)@(Model.ExtraStaffUntilUtc is { } paidUntil ? " " + Text.StaffExtraUntil(DisplayFormat.Date(paidUntil, Model.TimeZoneName)) : "")@(Model.ExtraStaffPrice.Length > 0 ? " " + string.Format(Text.StaffExtraPriceNote, Model.ExtraStaffPrice) : "")</p>
    <p class="actions">
        @if (Model.Level >= AdminLevel.Owner) { <a class="button secondary" href="/Admin/Billing">@Text.StaffBuyExtra</a> }
        @if (Model.ContactUrl.Length > 0) { <a class="button secondary" href="@Model.ContactUrl" target="_blank" rel="noopener">@Text.StaffMessageUs</a> }
    </p>
}

@if (Model.Rows.Count == 0)
{
    <div class="card empty"><p>@Text.StaffEmpty</p></div>
}
else
{
    <ul class="bookings">
        @foreach (var s in Model.Rows)
        {
            <li class="card @(s.IsActive ? "" : "inactive")">
                <div class="booking-head">
                    <strong>@s.Name</strong>
                    <span class="badge">@(s.IsActive ? Text.StatusActive : Text.StatusInactive)</span>
                </div>
                <p class="muted">@(s.ServiceNames.Count == 0 ? Text.StaffNoServices : string.Join(", ", s.ServiceNames))</p>
                <p><a href="/Admin/Staff/Edit/@s.Id">@Text.ActionEdit<span class="sr-only"> @s.Name</span></a></p>
            </li>
        }
    </ul>
}
