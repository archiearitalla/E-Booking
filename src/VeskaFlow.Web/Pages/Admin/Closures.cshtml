@page
@model VeskaFlow.Web.Pages.Admin.ClosuresModel
@{
    ViewData["Title"] = Text.AdminNavClosures;
}
<h1>@Text.AdminNavClosures</h1>

<div class="card">
    <h2>@Text.ClosureAdd</h2>
    <p class="hint">@Text.ClosureHint</p>
    <form method="post" asp-page-handler="Add" novalidate>
        @if (Model.Errors.Count > 0) { <div class="alert" role="alert">@Text.ValidationFailed</div> }

        <div class="field">
            <label for="StaffId">@Text.ClosureWho</label>
            <select id="StaffId" name="Input.StaffId">
                <option value="">@Text.ClosureWholeShop</option>
                @foreach (var s in Model.Staff)
                {
                    <option value="@s.Id" selected="@(Model.Input.StaffId == s.Id)">@s.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="FromDate">@Text.ClosureFrom</label>
            <input type="date" id="FromDate" name="Input.FromDate" value="@Model.Input.FromDate" required />
        </div>
        <div class="field">
            <label for="ToDate">@Text.ClosureTo</label>
            <input type="date" id="ToDate" name="Input.ToDate" value="@Model.Input.ToDate" required
                   aria-invalid="@(Model.ErrorFor("toDate") is null ? "false" : "true")" aria-describedby="ToDate-error" />
            @if (Model.ErrorFor("toDate") is { } e1) { <p class="error" id="ToDate-error">@e1</p> }
        </div>
        <div class="field">
            <label for="Reason">@Text.ClosureReason</label>
            <input type="text" id="Reason" name="Input.Reason" value="@Model.Input.Reason" maxlength="120"
                   aria-invalid="@(Model.ErrorFor("reason") is null ? "false" : "true")" aria-describedby="Reason-error" />
            @if (Model.ErrorFor("reason") is { } e2) { <p class="error" id="Reason-error">@e2</p> }
        </div>
        <button type="submit" class="primary">@Text.ClosureAddButton</button>
    </form>
</div>

<h2>@Text.ClosureUpcoming</h2>
@if (Model.Rows.Count == 0)
{
    <div class="card empty"><p>@Text.ClosuresEmpty</p></div>
}
else
{
    <ul class="bookings">
        @foreach (var c in Model.Rows)
        {
            <li class="card">
                <div class="booking-head">
                    <strong>@c.FromDate.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)@(c.ToDate != c.FromDate ? " – " + c.ToDate.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture) : "")</strong>
                    <span class="badge">@(c.StaffName ?? Text.ClosureWholeShop)</span>
                </div>
                @if (!string.IsNullOrEmpty(c.Reason)) { <p class="muted">@c.Reason</p> }
                @if (c.AffectedBookings > 0)
                {
                    <p class="warn" role="status">
                        @string.Format(Text.ClosureAffected, c.AffectedBookings)
                        <a href="/Admin?date=@DisplayFormat.DateParam(c.FromDate)">@Text.ClosureReview</a>
                    </p>
                }
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="id" value="@c.Id" />
                    <button type="submit" class="secondary">@Text.ClosureRemove<span class="sr-only"> @c.FromDate.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture)</span></button>
                </form>
            </li>
        }
    </ul>
}
