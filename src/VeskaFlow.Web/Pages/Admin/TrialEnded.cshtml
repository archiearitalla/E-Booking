@page
@model VeskaFlow.Web.Pages.Admin.TrialEndedModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Text.TrialEndedTitle;
    var billing = Model.Billing;
}
<div class="card">
    <h1>@Text.TrialEndedTitle</h1>
    <p>@Text.TrialEndedBody</p>
    @if (billing.HasDetails || Model.PayQrVersion is not null)
    {
        <h2>@Text.BillingTitle</h2>
        @if (Model.PayQrVersion is null)
        {
        <dl class="facts">
            @if (Model.PayQrVersion is null && billing.Price.Length > 0) { <dt>@Text.BillingPriceLabel</dt><dd>@billing.Price</dd> }
            @if (Model.PayQrVersion is null && billing.PayTo.Length > 0) { <dt>@Text.BillingPayToLabel</dt><dd>@billing.PayTo</dd> }
        </dl>
        }
        @if (Model.PayQrVersion is { } qrVersion) { <partial name="_PayQr" model="qrVersion" /> }
        <p class="hint">@(billing.Note.Length > 0 ? billing.Note : Text.BillingProof)</p>
    }
    @if (billing.ContactUrl.Length > 0)
    {
        <p><a class="button" href="@billing.ContactUrl">@Text.TrialEndedContact</a></p>
    }
    <form method="post" asp-page="/Logout">
        <button type="submit" class="secondary">@Text.NavSignOut</button>
    </form>
</div>
