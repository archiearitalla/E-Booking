@page
@model VeskaFlow.Web.Pages.Admin.Services.IndexModel
@{
    ViewData["Title"] = Text.AdminNavServices;
}
<h1>@Text.AdminNavServices</h1>
<p><a class="button" href="/Admin/Services/Edit">@Text.ServiceAdd</a></p>
<form method="post" asp-page-handler="Suggested" class="card">
    <p class="muted">@Text.ServicesSuggestedHint</p>
    <button type="submit" class="button secondary" data-confirm="@Text.ConfirmAddSuggested">@Text.ServicesSuggestedAdd</button>
</form>

@if (Model.Rows.Count == 0)
{
    <div class="card empty"><p>@Text.ServicesEmpty</p></div>
}
else
{
    <ul class="bookings">
        @foreach (var s in Model.Rows)
        {
            <li class="card @(s.IsActive ? "" : "inactive")">
                <details class="service-item">
                    <summary>
                        <span class="booking-head">
                            <strong>@s.Name</strong>
                            <span class="badge">@(s.IsActive ? Text.StatusActive : Text.StatusInactive)</span>
                        </span>
                    </summary>
                    <p class="muted">
                        @DisplayFormat.Duration(s.DurationMinutes)
                        @if (s.BufferMinutes > 0) { <text>(+@s.BufferMinutes min @Text.ServiceBufferShort)</text> }
                        &middot; @DisplayFormat.Price(s.Price)
                    </p>
                    @if (s.IsOther) { <p class="hint">@Text.OtherServiceIsOther</p> }
                    <p><a href="/Admin/Services/Edit/@s.Id">@Text.ActionEdit<span class="sr-only"> @s.Name</span></a></p>
                </details>
            </li>
        }
    </ul>
}
