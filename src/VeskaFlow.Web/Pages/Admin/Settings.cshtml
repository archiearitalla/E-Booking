@page
@model VeskaFlow.Web.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = Text.AdminNavSettings;
}
<h1>@Text.AdminNavSettings</h1>

<div class="card">
    <dl class="facts">
        <dt>@Text.SettingsAddress</dt><dd><code>/b/@Model.Slug</code> &middot; <a href="/b/@Model.Slug">@Text.SettingsOpenPage</a></dd>
        <dt>@Text.SettingsPlan</dt><dd><span class="badge">@Model.Plan</span></dd>
    </dl>
</div>

<div class="card card-wide">
    <h2>@Text.LogoTitle</h2>
    <p class="hint">@Text.LogoHint</p>
    @if (Model.LogoVersion is { } logoVersion)
    {
        <img class="logo-preview" src="/logo/@Model.Slug?v=@logoVersion" alt="@Text.LogoAlt" height="96" />
    }
    <form method="post" asp-page-handler="Logo" enctype="multipart/form-data" id="logo-form">
        <div class="field">
            <label for="logo-file">@Text.LogoChoose</label>
            <input type="file" id="logo-file" name="logo" accept="image/png,image/jpeg,image/webp" required />
        </div>
        <button type="submit" class="secondary" data-confirm="@Text.LogoSaveAsk">@Text.LogoUpload</button>
    </form>
    @if (Model.LogoVersion is not null)
    {
        <form method="post" asp-page-handler="RemoveLogo" class="actions">
            <button type="submit" class="danger" data-confirm="@Text.LogoRemoveAsk">@Text.LogoRemove</button>
        </form>
    }

    @* The Logo Creator: hidden until its script runs (without JavaScript the picture upload above is the way). It draws the logo in the
       browser and sends it through the form above, so the server checks it like any other logo. *@
    @{
        var creatorColor = LogoStyles.Colors.Any(c => c.Key == Model.Input.BrandColor) ? Model.Input.BrandColor : "teal";
    }
    <section id="logo-creator" class="logo-creator" hidden aria-labelledby="logo-creator-title"
             data-default-text="@LogoStyles.Initials(Model.Input.Name)" data-busy="@Text.LogoCreatorBusy" data-failed="@Text.LogoCreatorFailed">
        <h3 id="logo-creator-title">@Text.LogoCreatorTitle</h3>
        <p class="hint">@Text.LogoCreatorIntro</p>
        <div class="logo-creator-grid">
            <div class="logo-creator-preview">
                <img id="logo-creator-preview" alt="@Text.LogoCreatorPreview" width="192" height="192" />
            </div>
            <div class="logo-creator-fields">
                <div class="field">
                    <label for="logo-creator-text">@Text.LogoCreatorText</label>
                    <input type="text" id="logo-creator-text" maxlength="@LogoStyles.MaxText" aria-describedby="logo-creator-text-hint" autocomplete="off" />
                    <p class="hint" id="logo-creator-text-hint">@Text.LogoCreatorTextHint</p>
                </div>
                <fieldset class="field">
                    <legend>@Text.LogoCreatorShape</legend>
                    <div class="lc-options">
                        @foreach (var (key, label) in LogoStyles.Shapes)
                        {
                            <label class="choice"><input type="radio" name="lc-shape" value="@key" checked="@(key == "circle")" /><span>@label</span></label>
                        }
                    </div>
                </fieldset>
                <fieldset class="field">
                    <legend>@Text.LogoCreatorColors</legend>
                    <div class="lc-options">
                        @foreach (var (key, label, bg, fg) in LogoStyles.Colors)
                        {
                            <label class="choice">
                                <input type="radio" name="lc-color" value="@key" data-bg="@bg" data-fg="@fg" checked="@(key == creatorColor)" />
                                <span class="logo-swatch lc-c-@key" aria-hidden="true">A</span>
                                <span>@label</span>
                            </label>
                        }
                    </div>
                </fieldset>
                <fieldset class="field">
                    <legend>@Text.LogoCreatorIcon</legend>
                    <div class="lc-options">
                        @foreach (var (key, label, shapes) in LogoStyles.Icons)
                        {
                            <label class="choice">
                                <input type="radio" name="lc-icon" value="@key" checked="@(key == "scissors")" />
                                @if (shapes.Length > 0)
                                {
                                    <svg class="lc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@Html.Raw(shapes)</svg>
                                }
                                <span>@label</span>
                            </label>
                        }
                    </div>
                </fieldset>
                <fieldset class="field">
                    <legend>@Text.LogoCreatorFont</legend>
                    <div class="lc-options">
                        @foreach (var (key, label) in LogoStyles.Fonts)
                        {
                            <label class="choice"><input type="radio" name="lc-font" value="@key" checked="@(key == "sans")" /><span>@label</span></label>
                        }
                    </div>
                </fieldset>
                <p id="logo-creator-message" class="alert" role="alert" hidden></p>
                <button type="button" id="logo-creator-use" class="primary">@Text.LogoCreatorUse</button>
            </div>
        </div>
    </section>
    <script src="~/js/logo-creator.js" defer asp-append-version="true"></script>
</div>

<div class="card">
    <h2>@Text.EmailAddonTitle</h2>
    @if (Model.EmailAddonUntilUtc is { } addonUntil && addonUntil > DateTime.UtcNow)
    {
        <p>@Text.EmailAddonActive(DisplayFormat.Date(addonUntil, Model.TimeZoneName))</p>
    }
    else
    {
        <p class="hint">@Text.EmailAddonNone</p>
        @if (Model.Billing.EmailAddonPrice.Length > 0)
        {
            <dl class="facts"><dt>@Text.EmailAddonPriceLabel</dt><dd>@Model.Billing.EmailAddonPrice</dd>
                @if (Model.PayQrVersion is null && Model.Billing.PayTo.Length > 0) { <dt>@Text.BillingPayToLabel</dt><dd>@Model.Billing.PayTo</dd> }</dl>
            @if (Model.PayQrVersion is { } qrVersion) { <partial name="_PayQr" model="qrVersion" /> }
            <p class="hint">@Text.EmailAddonHow</p>
            @if (Model.Billing.ContactUrl.Length > 0) { <p><a class="button" href="@Model.Billing.ContactUrl" target="_blank" rel="noopener">@Text.BillingSendProof</a></p> }
        }
    }
</div>

<div class="card">
    <h2>@Text.AiAddonTitle</h2>
    @if (Model.AiAddonUntilUtc is { } aiUntil && aiUntil > DateTime.UtcNow)
    {
        <p>@Text.AiAddonActive(DisplayFormat.Date(aiUntil, Model.TimeZoneName))</p>
        <p class="hint">@Text.AiAddonUsage(Model.AiUsage.Conversations, Model.AiUsage.Limit)</p>
    }
    else
    {
        <p class="hint">@Text.AiAddonNone</p>
        @if (Model.Billing.AiAddonPrice.Length > 0)
        {
            <dl class="facts"><dt>@Text.AiAddonPriceLabel</dt><dd>@Model.Billing.AiAddonPrice</dd></dl>
            <p class="hint">@Text.AiAddonHow</p>
            @if (Model.Billing.ContactUrl.Length > 0) { <p><a class="button" href="@Model.Billing.ContactUrl" target="_blank" rel="noopener">@Text.BillingSendProof</a></p> }
        }
    }
</div>

<div class="card qr-print">
    <h2>@Text.QrTitle</h2>
    <p class="muted">@Text.QrHelp</p>
    <div class="qr-box" role="img" aria-label="@string.Format(Text.QrAlt, Model.BookingUrl)">@Html.Raw(Model.QrSvg)</div>
    <p class="qr-url"><code>@Model.BookingUrl</code></p>
    <div class="actions qr-actions">
        <a class="button" href="/Admin/Settings?handler=Qr">@Text.QrDownload</a>
        <button type="button" class="secondary" data-print>@Text.QrPrint</button>
    </div>
</div>

<div class="card">
    <h2 id="opening-hours">@Text.ShopHoursTitle</h2>
    <p class="hint">@Text.ShopHoursHint</p>
    <form method="post" asp-page-handler="Hours" novalidate>
        @if (Model.ErrorFor("hours") is { } he) { <div class="alert" role="alert">@he</div> }
        @await Html.PartialAsync("_HoursRange", Model.ShopRange)
        <button type="submit" class="primary" data-save data-confirm="@Text.ConfirmSaveShopHours">@Text.ShopHoursSave</button>
    </form>
</div>

<div class="card">
    <form method="post" novalidate>
        @if (Model.Errors.Count > 0 && !Model.HoursFormSubmitted) { <div class="alert" role="alert">@Text.ValidationFailed</div> }

        <div class="field">
            <label for="Name">@Text.LabelShopName</label>
            <input type="text" id="Name" name="Input.Name" value="@Model.Input.Name" maxlength="80"
                   aria-invalid="@(Model.ErrorFor("name") is null ? "false" : "true")" aria-describedby="Name-error" />
            @if (Model.ErrorFor("name") is { } e1) { <p class="error" id="Name-error">@e1</p> }
        </div>
        <div class="field">
            <label for="TimeZone">@Text.LabelTimeZone</label>
            <input type="text" id="TimeZone" name="Input.TimeZone" value="@Model.Input.TimeZone" maxlength="60" autocapitalize="none"
                   aria-invalid="@(Model.ErrorFor("timeZone") is null ? "false" : "true")" aria-describedby="TimeZone-hint TimeZone-error" />
            <p class="hint" id="TimeZone-hint">@Text.HintTimeZone</p>
            @if (Model.ErrorFor("timeZone") is { } e2) { <p class="error" id="TimeZone-error">@e2</p> }
        </div>
        <div class="field">
            <label for="SlotMinutes">@Text.LabelSlotMinutes</label>
            <select id="SlotMinutes" name="Input.SlotMinutes" aria-describedby="SlotMinutes-error">
                @foreach (var m in ShopSettingsService.AllowedSlotMinutes)
                {
                    <option value="@m" selected="@(Model.Input.SlotMinutes == m)">@m @Text.UnitMinutes</option>
                }
            </select>
            @if (Model.ErrorFor("slotMinutes") is { } e3) { <p class="error" id="SlotMinutes-error">@e3</p> }
        </div>
        <div class="field">
            <label for="LeadTimeMinutes">@Text.LabelLeadTime</label>
            <input type="number" id="LeadTimeMinutes" name="Input.LeadTimeMinutes" value="@Model.Input.LeadTimeMinutes" min="0" inputmode="numeric"
                   aria-invalid="@(Model.ErrorFor("leadTimeMinutes") is null ? "false" : "true")" aria-describedby="LeadTimeMinutes-error" />
            @if (Model.ErrorFor("leadTimeMinutes") is { } e4) { <p class="error" id="LeadTimeMinutes-error">@e4</p> }
        </div>
        <div class="field">
            <label for="HorizonDays">@Text.LabelHorizon</label>
            <input type="number" id="HorizonDays" name="Input.HorizonDays" value="@Model.Input.HorizonDays" min="1" max="365" inputmode="numeric"
                   aria-invalid="@(Model.ErrorFor("horizonDays") is null ? "false" : "true")" aria-describedby="HorizonDays-error" />
            @if (Model.ErrorFor("horizonDays") is { } e5) { <p class="error" id="HorizonDays-error">@e5</p> }
        </div>
        <div class="field">
            <label for="CancelCutoffHours">@Text.LabelCutoff</label>
            <input type="number" id="CancelCutoffHours" name="Input.CancelCutoffHours" value="@Model.Input.CancelCutoffHours" min="0" inputmode="numeric"
                   aria-invalid="@(Model.ErrorFor("cancelCutoffHours") is null ? "false" : "true")" aria-describedby="Cutoff-hint CancelCutoffHours-error" />
            <p class="hint" id="Cutoff-hint">@Text.HintCutoff</p>
            @if (Model.ErrorFor("cancelCutoffHours") is { } e6) { <p class="error" id="CancelCutoffHours-error">@e6</p> }
        </div>

        <div class="field">
            <label for="FollowUpNoticeDays">@Text.LabelFollowUpNoticeDays</label>
            <input type="number" id="FollowUpNoticeDays" name="Input.FollowUpNoticeDays" value="@Model.Input.FollowUpNoticeDays" min="0" max="60" inputmode="numeric"
                   aria-invalid="@(Model.ErrorFor("followUpNoticeDays") is null ? "false" : "true")" aria-describedby="FollowUpNoticeDays-hint FollowUpNoticeDays-error" />
            <p class="hint" id="FollowUpNoticeDays-hint">@Text.HintFollowUpNoticeDays</p>
            @if (Model.ErrorFor("followUpNoticeDays") is { } e8) { <p class="error" id="FollowUpNoticeDays-error">@e8</p> }
        </div>

        <div class="field">
            <label for="ReminderHours">@Text.LabelReminderHours</label>
            <input type="number" id="ReminderHours" name="Input.ReminderHours" value="@Model.Input.ReminderHours" min="1" max="168" inputmode="numeric"
                   aria-invalid="@(Model.ErrorFor("reminderHours") is null ? "false" : "true")" aria-describedby="ReminderHours-hint ReminderHours-error" />
            <p class="hint" id="ReminderHours-hint">@Text.HintReminderHours</p>
            @if (Model.ErrorFor("reminderHours") is { } e9) { <p class="error" id="ReminderHours-error">@e9</p> }
        </div>

        <div class="field">
            <label class="choice">
                <input type="checkbox" name="Input.CustomerEmails" value="true" checked="@Model.Input.CustomerEmails" />
                <span><strong>@Text.LabelCustomerEmails</strong><span class="muted"> @Text.HintCustomerEmails</span></span>
            </label>
            <input type="hidden" name="Input.CustomerEmails" value="false" />
        </div>

        <div class="field">
            <label class="choice">
                <input type="checkbox" name="Input.AllowManualTotal" value="true" checked="@Model.Input.AllowManualTotal" />
                <span><strong>@Text.LabelAllowManualTotal</strong><span class="muted"> @Text.HintAllowManualTotal</span></span>
            </label>
            <input type="hidden" name="Input.AllowManualTotal" value="false" />
        </div>

        <div class="field">
            <label class="choice">
                <input type="checkbox" name="Input.AllowManualSales" value="true" checked="@Model.Input.AllowManualSales" />
                <span><strong>@Text.LabelAllowManualSales</strong><span class="muted"> @Text.HintAllowManualSales</span></span>
            </label>
            <input type="hidden" name="Input.AllowManualSales" value="false" />
        </div>

        <fieldset class="field" aria-describedby="BrandColor-hint BrandColor-error">
            <legend>@Text.LabelBrandColor</legend>
            <div class="swatches">
                @foreach (var (key, label) in BrandColors.All)
                {
                    <label class="swatch" data-theme="@key">
                        <input type="radio" name="Input.BrandColor" value="@key" checked="@(Model.Input.BrandColor == key)" />
                        <span class="swatch-dot" aria-hidden="true"></span>
                        <span>@label</span>
                    </label>
                }
            </div>
            <p class="hint" id="BrandColor-hint">@Text.HintBrandColor</p>
            @if (Model.ErrorFor("brandColor") is { } e7) { <p class="error" id="BrandColor-error">@e7</p> }
        </fieldset>

        <button type="submit" class="primary" data-save data-confirm="@Text.ConfirmSaveSettings">@Text.ActionSave</button>
    </form>
</div>
