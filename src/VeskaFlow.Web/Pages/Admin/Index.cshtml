@page
@using VeskaFlow.Core.Domain
@model VeskaFlow.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = Text.AdminTitle;
    var view = Model.View!;
    var dateParam = DisplayFormat.DateParam(view.Date);
    var dateText = view.Date.ToString("dddd, MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture);
    var filter = Model.Filter;
    string Link(DateOnly d, string f) => $"?date={DisplayFormat.DateParam(d)}" + (f == IndexModel.Confirmed ? "" : $"&status={f}");
    (string Key, string Label)[] filters =
    [
        (IndexModel.Confirmed, Text.FilterConfirmed), (IndexModel.Cancelled, Text.FilterCancelled), (IndexModel.Done, Text.FilterDone),
    ];
    var shown = Model.Shown;
}
<h1>@Text.AdminNavBookings</h1>

<div class="card">
    <div class="daynav">
        <a href="@Link(view.Date.AddDays(-1), filter)">&laquo; @Text.DayPrevious</a>
        <strong>@dateText</strong>
        <a href="@Link(view.Date.AddDays(1), filter)">@Text.DayNext &raquo;</a>
    </div>
    <form method="get" class="inline-form">
        <label for="date">@Text.BookDate</label>
        <input type="date" id="date" name="date" value="@dateParam" />
        @if (filter != IndexModel.Confirmed) { <input type="hidden" name="status" value="@filter" /> }
        <button type="submit" class="primary">@Text.DayGo</button>
    </form>
</div>

@{
    var dayBookings = view.Bookings;
    var kpiRevenue = dayBookings.Where(x => x.Status == BookingStatus.Completed).Sum(x => x.Amount);
}
@{
    string KpiLink(string key) => $"?date={dateParam}" + (filter == IndexModel.Confirmed ? "" : $"&status={filter}") + (Model.OpenKpi == key ? "" : $"&kpi={key}") + "#kpi-details";
    var kpiCards = new (string Key, string Value, string Label)[]
    {
        ("todo", dayBookings.Count(x => x.Status == BookingStatus.Confirmed).ToString(), Text.KpiToDo),
        ("done", dayBookings.Count(x => x.Status == BookingStatus.Completed).ToString(), Text.KpiDone),
        ("earned", DisplayFormat.Price(kpiRevenue), Text.KpiRevenue),
        ("noshow", dayBookings.Count(x => x.Status == BookingStatus.NoShow).ToString(), Text.KpiNoShows),
        ("cancelled", dayBookings.Count(x => x.Status == BookingStatus.Cancelled).ToString(), Text.KpiCancelled),
    };
}
<section class="kpis" aria-label="@Text.KpiLabel">
    @foreach (var card in kpiCards)
    {
        @* Each card is a link: clicking it lists that group's bookings with their details just below; clicking it again closes the list. *@
        <a class="kpi @(Model.OpenKpi == card.Key ? "open" : "")" href="@KpiLink(card.Key)" aria-current="@(Model.OpenKpi == card.Key ? "true" : null)" data-kpi="@card.Key"><span class="kpi-value">@card.Value</span><span class="kpi-label">@card.Label</span></a>
    }
</section>

@if (Model.OpenKpi is { } openKpi)
{
    var detailRows = Model.KpiBookings;
    <section class="card kpi-details" id="kpi-details" tabindex="-1" aria-label="@Text.KpiDetailsTitle">
        <h2>@kpiCards.First(k => k.Key == openKpi).Label &middot; @dateText</h2>
        @if (detailRows.Count == 0)
        {
            <p class="muted">@Text.KpiDetailsNone</p>
        }
        else
        {
            @* One short line per booking so a busy day stays easy to scan; tap a line for the rest. *@
            <ul class="kpi-list">
                @foreach (var d in detailRows)
                {
                    <li>
                        <details>
                            <summary>
                                <span class="kpi-time">@DisplayFormat.Time(d.StartsAtUtc, view.TimeZone)</span>
                                <span class="kpi-who">@d.CustomerName</span>
                                <span class="kpi-what muted">@d.ServiceName@(d.ExtraLines.Count > 0 ? $" +{d.ExtraLines.Count}" : "")</span>
                                <span class="kpi-price">@DisplayFormat.Price(d.Status == BookingStatus.Completed ? d.Amount : d.Price)</span>
                            </summary>
                            <div class="kpi-more">
                                <p><strong>@DisplayFormat.Time(d.StartsAtUtc, view.TimeZone) &ndash; @DisplayFormat.Time(d.EndsAtUtc, view.TimeZone)</strong> <span class="badge">@d.Status.Label()</span></p>
                                <dl class="facts">
                                    <dt>@Text.ManageService</dt><dd>@d.ServiceName &middot; <partial name="_PriceLine" model="new PriceLineModel(d.Price, d.RegularPrice, d.DiscountPercent)" />@if (d.ExtraLines.Count > 0) { <text> + @string.Join(", ", d.ExtraLines.Select(x => x.Name))</text> }</dd>
                                    @if (d.Status == BookingStatus.Completed)
                                    {
                                        <dt>@Text.AfterVisitPaymentTitle</dt><dd>@DisplayFormat.Price(d.Amount)</dd>
                                    }
                                    <dt>@Text.ManageWith</dt><dd>@d.StaffName</dd>
                                    <dt>@Text.ManageWho</dt><dd>@d.CustomerName
                                        @if (DisplayFormat.IsPlaceholderPhone(d.CustomerPhone)) { <span class="muted">&middot; @Text.WalkInNoPhone</span> } else { <text>&middot; <a href="tel:@d.CustomerPhone">@d.CustomerPhone</a></text> }</dd>
                                </dl>
                                @if (d.Status == BookingStatus.Completed) { <p><a href="/Admin/AfterVisit/@d.Id">@Text.AfterVisitOpen</a></p> }
                            </div>
                        </details>
                    </li>
                }
            </ul>
        }
        <p><a href="@KpiLink(openKpi)">@Text.KpiDetailsClose</a></p>
    </section>
}

<nav class="seg" aria-label="@Text.FilterLabel">
    @foreach (var (key, label) in filters)
    {
        <a href="@Link(view.Date, key)" aria-current="@(key == filter ? "true" : null)">@label <span class="count">@Model.CountFor(key)</span></a>
    }
</nav>

@if (shown.Count == 0)
{
    <div class="card empty"><p>@(filter == IndexModel.Cancelled ? Text.DayEmptyCancelled : filter == IndexModel.Done ? Text.DayEmptyDone : Text.DayEmptyConfirmed)</p></div>
}
else
{
    <ul class="bookings">
        @foreach (var b in shown)
        {
            <li class="card booking @(b.Status.OccupiesSlot() ? "" : "inactive")">
                <div class="booking-head">
                    <strong>@DisplayFormat.Time(b.StartsAtUtc, view.TimeZone) &ndash; @DisplayFormat.Time(b.EndsAtUtc, view.TimeZone)</strong>
                    <span class="badge">@b.Status.Label()</span>
                </div>
                <dl class="facts">
                    <dt>@Text.ManageService</dt><dd>@b.ServiceName &middot; <partial name="_PriceLine" model="new PriceLineModel(b.Price, b.RegularPrice, b.DiscountPercent)" />@if (b.ExtraLines.Count > 0) { <text> + @string.Join(", ", b.ExtraLines.Select(x => x.Name))</text> }@if (b.Status == BookingStatus.Completed && b.PaidAmount is { } paidTotal) { <text> &middot; @Text.AfterVisitPaidShort(DisplayFormat.Price(paidTotal))</text> }</dd>
                    <dt>@Text.ManageWith</dt><dd>@b.StaffName</dd>
                    <dt>@Text.ManageWho</dt><dd>@b.CustomerName
                        @if (DisplayFormat.IsPlaceholderPhone(b.CustomerPhone)) { <span class="muted">&middot; @Text.WalkInNoPhone</span> } else { <text>&middot; <a href="tel:@b.CustomerPhone">@b.CustomerPhone</a></text> }</dd>
                </dl>

                @if (b.Status == VeskaFlow.Core.Domain.BookingStatus.Confirmed)
                {
                    @* A status button is shown only when it can be used: today, and after the scheduled time. Before that
                       only a short note says when it will appear. *@
                    @if (b.CanComplete || b.CanNoShow)
                    {
                        <form method="post" asp-page-handler="Transition" class="actions">
                            <input type="hidden" name="id" value="@b.Id" />
                            <input type="hidden" name="version" value="@b.Version" />
                            <input type="hidden" name="date" value="@dateParam" />
                            <input type="hidden" name="status" value="@filter" />
                            @if (b.CanComplete) { <button type="submit" name="action" value="complete" class="primary" data-confirm="@Text.ConfirmComplete">@Text.ActionComplete</button> }
                            @if (b.CanNoShow) { <button type="submit" name="action" value="noshow" class="secondary" data-confirm="@Text.ConfirmNoShow">@Text.ActionNoShow</button> }
                        </form>
                    }
                    @if (!view.IsToday) { <p class="hint">@Text.StatusOnlyToday</p> }
                    else if (!b.CanComplete) { <p class="hint">@Text.StatusLater</p> }
                    else if (!b.CanNoShow) { <p class="hint">@Text.NoShowLater</p> }
                }
                @if (b.Status == VeskaFlow.Core.Domain.BookingStatus.Completed)
                {
                    <div class="after-visit">
                        @if (b.FollowUpOn is { } fuOn)
                        {
                            <p class="muted">@Text.FollowUpTitle: @fuOn.ToString("ddd, MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)@(string.IsNullOrEmpty(b.FollowUpService) ? "" : " · " + b.FollowUpService)</p>
                        }
                        @if (!string.IsNullOrEmpty(b.VisitNotes)) { <p class="muted">@Text.VisitNotesOnFile</p> }
                        <div class="actions">
                            <a class="button" href="/Admin/AfterVisit/@b.Id">@Text.AfterVisitOpen</a>
                            <a class="button secondary" href="/Admin/History/@b.CustomerId">@Text.HistoryLink</a>
                        </div>
                    </div>
                }
                @if (b.CanMove)
                {
                    <div class="actions"><a class="button secondary" href="/Admin/Reschedule/@b.Id">@Text.RescheduleLink</a></div>
                }
                @if (b.CanCancel)
                {
                    <form method="post" asp-page-handler="Transition" class="actions cancel-form">
                        <input type="hidden" name="id" value="@b.Id" />
                        <input type="hidden" name="version" value="@b.Version" />
                        <input type="hidden" name="date" value="@dateParam" />
                        <input type="hidden" name="status" value="@filter" />
                        <label for="reason-@b.Id">@Text.CancelReason</label>
                        <input type="text" id="reason-@b.Id" name="reason" maxlength="200" required />
                        <button type="submit" name="action" value="cancel" class="danger" data-confirm="@Text.ConfirmCancelStaff">@Text.ActionCancel</button>
                    </form>
                }
            </li>
        }
    </ul>
}
