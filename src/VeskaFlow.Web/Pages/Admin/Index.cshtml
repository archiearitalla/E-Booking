@page
@using VeskaFlow.Core.Domain
@model VeskaFlow.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = Text.AdminTitle;
    var view = Model.View!;
    var dateParam = DisplayFormat.DateParam(view.Date);
    var dateText = view.Date.ToString("dddd, MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture);
    var filter = Model.Filter;
    string Link(DateOnly d, string f) => $"?date={DisplayFormat.DateParam(d)}" + (f == IndexModel.Confirmed ? "" : $"&status={f}");
    (string Key, string Label)[] filters =
    [
        (IndexModel.Confirmed, Text.FilterConfirmed), (IndexModel.Cancelled, Text.FilterCancelled), (IndexModel.Done, Text.FilterDone),
    ];
    var shown = Model.Shown;
}
<h1>@Text.AdminNavBookings</h1>

<div class="card">
    <div class="daynav">
        <a href="@Link(view.Date.AddDays(-1), filter)">&laquo; @Text.DayPrevious</a>
        <strong>@dateText</strong>
        <a href="@Link(view.Date.AddDays(1), filter)">@Text.DayNext &raquo;</a>
    </div>
    <form method="get" class="inline-form">
        <label for="date">@Text.BookDate</label>
        <input type="date" id="date" name="date" value="@dateParam" />
        @if (filter != IndexModel.Confirmed) { <input type="hidden" name="status" value="@filter" /> }
        <button type="submit" class="primary">@Text.DayGo</button>
    </form>
</div>

<nav class="seg" aria-label="@Text.FilterLabel">
    @foreach (var (key, label) in filters)
    {
        <a href="@Link(view.Date, key)" aria-current="@(key == filter ? "true" : null)">@label <span class="count">@Model.CountFor(key)</span></a>
    }
</nav>

@if (shown.Count == 0)
{
    <div class="card empty"><p>@(filter == IndexModel.Cancelled ? Text.DayEmptyCancelled : filter == IndexModel.Done ? Text.DayEmptyDone : Text.DayEmptyConfirmed)</p></div>
}
else
{
    <ul class="bookings">
        @foreach (var b in shown)
        {
            <li class="card booking @(b.Status.OccupiesSlot() ? "" : "inactive")">
                <div class="booking-head">
                    <strong>@DisplayFormat.Time(b.StartsAtUtc, view.TimeZone) &ndash; @DisplayFormat.Time(b.EndsAtUtc, view.TimeZone)</strong>
                    <span class="badge">@b.Status.Label()</span>
                </div>
                <dl class="facts">
                    <dt>@Text.ManageService</dt><dd>@b.ServiceName &middot; @DisplayFormat.Price(b.Price)</dd>
                    <dt>@Text.ManageWith</dt><dd>@b.StaffName</dd>
                    <dt>@Text.ManageWho</dt><dd>@b.CustomerName
                        @if (DisplayFormat.IsPlaceholderPhone(b.CustomerPhone)) { <span class="muted">&middot; @Text.WalkInNoPhone</span> } else { <text>&middot; <a href="tel:@b.CustomerPhone">@b.CustomerPhone</a></text> }</dd>
                </dl>

                @if (b.CanComplete || b.CanNoShow)
                {
                    <form method="post" asp-page-handler="Transition" class="actions">
                        <input type="hidden" name="id" value="@b.Id" />
                        <input type="hidden" name="version" value="@b.Version" />
                        <input type="hidden" name="date" value="@dateParam" />
                        <input type="hidden" name="status" value="@filter" />
                        @if (b.CanComplete) { <button type="submit" name="action" value="complete" class="primary">@Text.ActionComplete</button> }
                        @if (b.CanNoShow) { <button type="submit" name="action" value="noshow" class="secondary">@Text.ActionNoShow</button> }
                    </form>
                }
                @if (b.Status == VeskaFlow.Core.Domain.BookingStatus.Completed)
                {
                    <div class="after-visit">
                        <h3>@Text.AfterVisitTitle</h3>
                        <p class="hint">@Text.AfterVisitHint</p>
                        @await Html.PartialAsync("_SendMessage", new VeskaFlow.Web.Pages.SendMessageModel(
                            "t" + b.Id.ToString("N"), Model.ThankYouFor(b), b.CustomerPhone, b.CustomerEmail, Text.ThankYouSubject(Model.ShopName),
                            $"/Admin?handler=Contact&id={b.Id}"))
                    </div>
                    <form method="post" asp-page-handler="FollowUp" class="followup-form">
                        <input type="hidden" name="id" value="@b.Id" />
                        <input type="hidden" name="date" value="@dateParam" />
                        <input type="hidden" name="status" value="@filter" />
                        @{ var fuValue = (b.FollowUpOn ?? b.SuggestedFollowUp) is { } fuDate ? DisplayFormat.DateParam(fuDate) : ""; }
                        <h3>@Text.FollowUpTitle</h3>
                        @if (b.FollowUpOn is null && b.SuggestedFollowUp is not null) { <p class="hint">@Text.FollowUpSuggested</p> }
                        <div class="field">
                            <label for="fu-@b.Id">@Text.FollowUpDate</label>
                            <input type="date" id="fu-@b.Id" name="followUpOn" value="@fuValue" />
                        </div>
                        <div class="field">
                            <label for="fun-@b.Id">@Text.FollowUpNote</label>
                            <input type="text" id="fun-@b.Id" name="followUpNote" value="@b.FollowUpNote" maxlength="200" />
                        </div>
                        <div class="actions">
                            <button type="submit" class="primary">@Text.FollowUpSave</button>
                            @if (b.FollowUpOn is not null) { <button type="submit" name="clear" value="1" class="secondary">@Text.FollowUpRemove</button> }
                        </div>
                    </form>
                }
                @if (b.CanCancel)
                {
                    <form method="post" asp-page-handler="Transition" class="actions cancel-form">
                        <input type="hidden" name="id" value="@b.Id" />
                        <input type="hidden" name="version" value="@b.Version" />
                        <input type="hidden" name="date" value="@dateParam" />
                        <input type="hidden" name="status" value="@filter" />
                        <label for="reason-@b.Id">@Text.CancelReason</label>
                        <input type="text" id="reason-@b.Id" name="reason" maxlength="200" />
                        <button type="submit" name="action" value="cancel" class="danger">@Text.ActionCancel</button>
                    </form>
                }
            </li>
        }
    </ul>
}
