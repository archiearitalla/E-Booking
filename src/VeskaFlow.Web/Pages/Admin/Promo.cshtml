@page
@model VeskaFlow.Web.Pages.Admin.PromoModel
@{
    ViewData["Title"] = Text.PromoTitle;
    var banner = Model.Banner;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    string Day(DateOnly d) => d.ToString("MMMM d", invariant);
    var previewTheme = PromoThemes.Normalize(Model.Input.Theme);
    var preview = new PromoCardModel(previewTheme, Model.Input.Caption ?? "", Model.Input.Details, Model.Input.Badge,
        banner.HasPicture ? $"/Admin/Promo?handler=Image&v={banner.Version}" : null,
        Model.Input.EndsOn is { } previewLast ? Day(previewLast) : null, Live: true);
}
<h1>@Text.PromoTitle</h1>

<div class="card">
    <p class="hint">@Text.PromoIntro</p>
    <p role="status">
        <strong>
            @switch (banner.State)
            {
                case PromoState.Showing: @Text.PromoStatusShowing break;
                case PromoState.Paused: @Text.PromoStatusPaused break;
                case PromoState.Ended: @Text.PromoStatusEnded(Day(banner.EndsOn!.Value)) break;
                default: @Text.PromoStatusNone break;
            }
        </strong>
        @if (banner.State == PromoState.Showing && banner.EndsOn is { } until) { <span class="muted">@Text.PromoStatusUntil(Day(until))</span> }
    </p>
</div>

<div class="card">
    <h2>@Text.PromoPreviewTitle</h2>
    <p class="hint">@Text.PromoPreviewHint</p>
    <div id="promo-preview" data-placeholder="@Text.PromoPreviewPlaceholder" data-until="@Text.PromoUntilChip("{date}")">
        <partial name="_PromoCard" model="preview" />
    </div>
    @* The decoration of every mode, so the preview can switch between them without asking the server. *@
    <div id="promo-icons" hidden>
        @foreach (var key in PromoThemes.All)
        {
            <svg data-promo-icon="@key"><partial name="_PromoIcon" model="key" /></svg>
        }
    </div>
</div>

<div class="card">
    <form method="post" enctype="multipart/form-data" id="promo-form">
        <fieldset class="field">
            <legend>@Text.PromoThemeLegend</legend>
            <div class="people">
                @foreach (var key in PromoThemes.All)
                {
                    <label class="choice person">
                        <input type="radio" name="Input.Theme" value="@key" data-kicker="@PromoThemes.Kicker(key)" checked="@(previewTheme == key)" />
                        <span class="promo-swatch promo-t-@key" aria-hidden="true"></span>
                        <span><strong>@PromoThemes.Label(key)</strong></span>
                    </label>
                }
            </div>
            <p class="hint">@Text.PromoThemeHint</p>
        </fieldset>
        <div class="field">
            <label for="promo-caption">@Text.PromoCaptionLabel</label>
            <input type="text" id="promo-caption" name="Input.Caption" value="@Model.Input.Caption" maxlength="100" required aria-describedby="promo-caption-hint" />
            <p class="hint" id="promo-caption-hint">@Text.PromoCaptionHint</p>
        </div>
        <div class="field">
            <label for="promo-badge">@Text.PromoBadgeLabel</label>
            <input type="text" id="promo-badge" name="Input.Badge" value="@Model.Input.Badge" maxlength="16" aria-describedby="promo-badge-hint" />
            <p class="hint" id="promo-badge-hint">@Text.PromoBadgeHint</p>
        </div>
        <div class="field">
            <label for="promo-details">@Text.PromoDetailsLabel</label>
            <input type="text" id="promo-details" name="Input.Details" value="@Model.Input.Details" maxlength="140" aria-describedby="promo-details-hint" />
            <p class="hint" id="promo-details-hint">@Text.PromoDetailsHint</p>
        </div>
        <div class="field">
            <label for="promo-ends">@Text.PromoEndsLabel</label>
            <input type="date" id="promo-ends" name="Input.EndsOn" value="@(Model.Input.EndsOn?.ToString("yyyy-MM-dd", invariant))"
                   min="@banner.Today.ToString("yyyy-MM-dd", invariant)" max="@banner.Today.AddDays(PromoBannerService.MaxDaysAhead).ToString("yyyy-MM-dd", invariant)" aria-describedby="promo-ends-hint" />
            <p class="hint" id="promo-ends-hint">@Text.PromoEndsHint</p>
        </div>
        <div class="field">
            <label for="promo-picture">@Text.PromoPictureLabel</label>
            <input type="file" id="promo-picture" name="picture" accept="image/png,image/jpeg,image/webp" aria-describedby="promo-picture-hint" />
            <p class="hint" id="promo-picture-hint">@Text.PromoPictureHint</p>
        </div>
        @if (banner.HasPicture)
        {
            <label class="choice">
                <input type="checkbox" name="Input.RemovePicture" value="true" />
                <span>@Text.PromoRemovePicture</span>
            </label>
        }
        <label class="choice">
            <input type="checkbox" name="Input.Active" value="true" checked="@Model.Input.Active" />
            <span>@Text.PromoActiveLabel</span>
        </label>
        <div class="actions">
            <button type="submit" class="primary">@Text.PromoSave</button>
        </div>
    </form>

    @if (banner.Exists)
    {
        <form method="post" asp-page-handler="Remove" class="actions">
            <button type="submit" class="danger" data-confirm="@Text.PromoRemoveAsk">@Text.PromoRemove</button>
        </form>
    }
</div>

<script src="~/js/promo-creator.js" defer asp-append-version="true"></script>
