@page
@model VeskaFlow.Web.Pages.ResetPasswordModel
@{
    ViewData["Title"] = Text.ResetTitle;
}
<div class="card">
    <h1>@Text.ResetTitle</h1>
    @if (!Model.LinkValid)
    {
        <div class="alert" role="alert">@Text.ResetLinkInvalid</div>
        <p class="auth-alt"><a href="/ForgotPassword">@Text.ResetAskAgain</a></p>
    }
    else
    {
        <form method="post" novalidate>
            <input type="hidden" name="Token" value="@Model.Token" />
            <div class="field">
                <label for="Password">@Text.ResetNewPassword</label>
                <input type="password" id="Password" name="Password" minlength="8" maxlength="128" autocomplete="new-password" required
                       aria-invalid="@(Model.ErrorFor("password") is null ? "false" : "true")" />
                <p class="hint">@Text.PasswordHint</p>
                @if (Model.ErrorFor("password") is { } e1) { <p class="error">@e1</p> }
            </div>
            <div class="field">
                <label for="Confirm">@Text.ResetConfirmPassword</label>
                <input type="password" id="Confirm" name="Confirm" minlength="8" maxlength="128" autocomplete="new-password" required />
                @if (Model.ErrorFor("confirm") is { } e2) { <p class="error">@e2</p> }
            </div>
            <button type="submit" class="primary">@Text.ResetSave</button>
        </form>
    }
</div>
