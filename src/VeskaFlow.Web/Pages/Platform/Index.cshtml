@page
@model VeskaFlow.Web.Pages.Platform.IndexModel
@{
    ViewData["Title"] = Text.PlatformTitle;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
}
@section Head {
    <meta name="robots" content="noindex" />
}
<h1>@Text.PlatformTitle</h1>
<p class="muted">@Text.PlatformEmailsToday(Model.EmailsToday, Model.EmailLimit)</p>
<p class="hint">@Text.PlatformHint</p>
<p class="actions"><a class="button secondary" href="/Platform/Payments">@Text.PaymentsLink</a> <a class="button secondary" href="/Platform/Ai">@Text.PlatformAiLink</a></p>
@if (!Model.EmailConfigured) { <div class="notice" role="status">@Text.PlatformNoEmail</div> }
@if (!string.IsNullOrEmpty(Model.Success)) { <div class="notice" role="status">@Model.Success</div> }
@if (!string.IsNullOrEmpty(Model.Failure)) { <div class="alert" role="alert">@Model.Failure</div> }
@if (!string.IsNullOrEmpty(Model.LinkToCopy))
{
    <div class="card">
        <div class="field">
            <label for="confirm-link">@Text.PlatformLinkLabel</label>
            <input type="text" id="confirm-link" readonly value="@Model.LinkToCopy" />
        </div>
        <button type="button" class="secondary" data-copy="confirm-link" data-copied="@Text.FollowUpCopied">@Text.ManageCopyLink</button>
    </div>
}

@if (Model.DueItems.Count > 0)
{
    <div class="notice" role="status">
        <strong>@Text.ExpiryAlert(Model.DueItems.Select(i => i.BusinessId).Distinct().Count())</strong>
        <ul class="expiry-list">
            @foreach (var it in Model.DueItems)
            {
                <li class="@(it.DaysLeft < 0 ? "due" : "")"><a href="?q=@Uri.EscapeDataString(it.Slug)">@it.Shop</a> &middot; @Text.ExpiryLine(it.What, it.EndUtc.ToString("MMM d, yyyy", invariant), it.DaysLeft)</li>
            }
        </ul>
        @if (Model.OnlyExpiring) { <a href="/Platform">@Text.ExpiryShowAll</a> } else { <a href="?expiring=true">@Text.ExpiryOnlyDue</a> }
    </div>
}

<form method="get" class="inline-form shop-search" data-search-submit>
    <label for="q" class="sr-only">@Text.PlatformSearch</label>
    <input type="text" id="q" name="q" class="grow" value="@Model.Query" placeholder="@Text.PlatformSearch" maxlength="80" list="shop-suggestions" autocomplete="off" />
    <datalist id="shop-suggestions">
        @foreach (var sh in Model.AllShops) { <option value="@sh.Name" label="@sh.OwnerEmail &middot; /b/@sh.Slug"></option> }
    </datalist>
    <button type="submit" class="primary">@Text.DayGo</button>
</form>
<p class="muted">@Text.PlatformCount(Model.Shops.Count)</p>

@if (Model.Shops.Count == 0)
{
    <div class="card empty"><p>@Text.PlatformEmpty</p></div>
}
else
{
    <ul class="bookings shop-list">
        @foreach (var s in Model.Shops)
        {
            <li class="card @(s.Enabled ? "" : "inactive")">
                @* One short line per shop; open it for the details and the buttons. *@
                <details>
                <summary class="shop-sum">
                    <strong class="shop-name">@s.Name</strong>
                    <span class="shop-badges">
                        <span class="badge @(s.Enabled ? "" : "off")">@(s.Enabled ? Text.PlatformOn : Text.PlatformOff)</span>
                        @if (!s.EmailConfirmed) { <span class="badge off">@Text.PlatformEmailPending</span> }
                        @if (s.AiAddonUntilUtc is { } aiOn && aiOn > DateTime.UtcNow) { <span class="badge">@Text.PlatformAiAddon</span> }
                    </span>
                    <span class="shop-sub muted">@s.OwnerEmail &middot; /b/@s.Slug</span>
                    @{ var dueNow = ShopExpiry.Due(s, Model.Now); }
                    <span class="shop-exp @(dueNow.Count > 0 ? "due" : "muted")">
                        @if (s.TrialEndsAtUtc is { } accessEnd) { @Text.ExpiryLine(Text.ExpiryWhatAccess, accessEnd.ToString("MMM d, yyyy", invariant), ShopExpiry.DaysLeft(accessEnd, Model.Now)) } else { @Text.ExpiryNoEnd }
                        @foreach (var extra in ShopExpiry.All(s, Model.Now).Where(i => i.What != Text.ExpiryWhatAccess && i.DaysLeft >= -ShopExpiry.RecentDays)) { <text> &middot; @Text.ExpiryLine(extra.What, extra.EndUtc.ToString("MMM d, yyyy", invariant), extra.DaysLeft)</text> }
                    </span>
                </summary>
                <div class="kpi-more">
                <dl class="facts">
                    <dt>@Text.PlatformOwner</dt><dd>@s.OwnerName &middot; @s.OwnerEmail</dd>
                    <dt>@Text.SettingsAddress</dt><dd><a href="/b/@s.Slug">/b/@s.Slug</a> &middot; @s.Industry</dd>
                    <dt>@Text.PlatformSignedUp</dt><dd>@s.CreatedAtUtc.ToString("MMM d, yyyy", invariant)</dd>
                </dl>

                <h3 class="sub-title">@Text.PlatformSubscription</h3>
                <div class="sub-rows">
                    @{
                        string Status(DateTime? end, string none) => end is { } e && ShopExpiry.DaysLeft(e, Model.Now) >= 0
                            ? Text.PlatformUntil(e.ToString("MMM d, yyyy", invariant), ShopExpiry.DaysLeft(e, Model.Now))
                            : end is { } gone ? Text.PlatformEnded(gone.ToString("MMM d, yyyy", invariant)) : none;
                        bool Warn(DateTime? end) => ShopExpiry.IsDue(end, Model.Now);
                    }
                    <div class="sub-row">
                        <div class="sub-info"><strong>@Text.ExpiryWhatAccess</strong><span class="sub-status @(Warn(s.TrialEndsAtUtc) ? "due" : "muted")">@Status(s.TrialEndsAtUtc, Text.ExpiryNoEnd)</span></div>
                        @if (s.TrialEndsAtUtc is not null)
                        {
                        <form method="post" asp-page-handler="Extend" class="sub-form">
                            <input type="hidden" name="id" value="@s.BusinessId" />
                            <label for="extend-@s.BusinessId" class="sr-only">@Text.PlatformExtendDays @s.Name</label>
                            <select id="extend-@s.BusinessId" name="days">
                                @foreach (var d in AccountControlService.ExtendChoices) { <option value="@d" selected="@(d == 30)">@Text.PlatformDaysLabel(d)</option> }
                            </select>
                            <button type="submit" class="secondary" data-confirm="@Text.PlatformExtendAsk">@Text.PlatformAddDays<span class="sr-only"> @s.Name</span></button>
                        </form>
                        }
                    </div>
                    <div class="sub-row">
                        <div class="sub-info"><strong>@Text.PlatformAiAddon</strong><span class="sub-status @(Warn(s.AiAddonUntilUtc) ? "due" : "muted")">@Status(s.AiAddonUntilUtc, Text.PlatformAiAddonNone)</span></div>
                        <form method="post" asp-page-handler="AiAddon" class="sub-form">
                            <input type="hidden" name="id" value="@s.BusinessId" />
                            <label for="aiaddon-@s.BusinessId" class="sr-only">@Text.PlatformAiAddon @s.Name</label>
                            <select id="aiaddon-@s.BusinessId" name="days">
                                @foreach (var d in AccountControlService.ExtendChoices) { <option value="@d" selected="@(d == 30)">@Text.PlatformDaysLabel(d)</option> }
                            </select>
                            <button type="submit" class="secondary" data-confirm="@Text.PlatformAiAddonAsk">@Text.PlatformAddDays<span class="sr-only"> @s.Name</span></button>
                        </form>
                    </div>
                    <div class="sub-row">
                        <div class="sub-info"><strong>@Text.PlatformEmailAddon</strong><span class="sub-status @(Warn(s.EmailAddonUntilUtc) ? "due" : "muted")">@Status(s.EmailAddonUntilUtc, Text.PlatformEmailAddonNone)</span></div>
                        @if (s.TrialEndsAtUtc is not null)
                        {
                        <form method="post" asp-page-handler="EmailAddon" class="sub-form">
                            <input type="hidden" name="id" value="@s.BusinessId" />
                            <label for="emailaddon-@s.BusinessId" class="sr-only">@Text.PlatformEmailAddon @s.Name</label>
                            <select id="emailaddon-@s.BusinessId" name="days">
                                @foreach (var d in AccountControlService.ExtendChoices) { <option value="@d" selected="@(d == 30)">@Text.PlatformDaysLabel(d)</option> }
                            </select>
                            <button type="submit" class="secondary" data-confirm="@Text.PlatformEmailAddonAsk">@Text.PlatformAddDays<span class="sr-only"> @s.Name</span></button>
                        </form>
                        }
                    </div>
                </div>

                <div class="shop-actions">
                    @if (!s.EmailConfirmed)
                    {
                        <form method="post" asp-page-handler="ConfirmNow">
                            <input type="hidden" name="id" value="@s.BusinessId" />
                            <button type="submit" class="secondary" data-confirm="@Text.PlatformConfirmNowAsk">@Text.PlatformConfirmNow<span class="sr-only"> @s.Name</span></button>
                        </form>
                        <form method="post" asp-page-handler="SendLink">
                            <input type="hidden" name="id" value="@s.BusinessId" />
                            <button type="submit" class="secondary" data-confirm="@Text.PlatformSendLinkAsk">@Text.PlatformSendLink<span class="sr-only"> @s.Name</span></button>
                        </form>
                    }
                    <form method="post" asp-page-handler="Enable" class="push-right">
                        <input type="hidden" name="id" value="@s.BusinessId" />
                        <input type="hidden" name="on" value="@((!s.Enabled).ToString().ToLowerInvariant())" />
                        <button type="submit" class="@(s.Enabled ? "danger" : "primary")" data-confirm="@(s.Enabled ? Text.PlatformConfirmOff : Text.PlatformConfirmOn)">@(s.Enabled ? Text.PlatformSwitchOff : Text.PlatformSwitchOn)<span class="sr-only"> @s.Name</span></button>
                    </form>
                </div>
                    @if (s.BusinessId != Model.OwnBusinessId)
                    {
                        <details class="delete-shop">
                            <summary class="danger-link">@Text.PlatformDeleteShop<span class="sr-only"> @s.Name</span></summary>
                            <form method="post" asp-page-handler="Delete">
                                <input type="hidden" name="id" value="@s.BusinessId" />
                                <p class="warn">@Text.PlatformDeleteWarning</p>
                                <div class="field">
                                    <label for="confirm-@s.BusinessId">@string.Format(Text.PlatformDeleteType, s.Slug)</label>
                                    <input type="text" id="confirm-@s.BusinessId" name="confirm" autocomplete="off" autocapitalize="none" required />
                                </div>
                                <button type="submit" class="danger" data-confirm="@Text.PlatformDeleteAsk">@Text.PlatformDeleteForever</button>
                            </form>
                        </details>
                    }
                </div>
                </details>
            </li>
        }
    </ul>
}

<div class="card">
    <h2>@Text.PayQrTitle</h2>
    <p class="hint">@Text.PayQrHint</p>
    @if (Model.PayQrVersion is { } payQrVersion)
    {
        <img class="pay-qr" src="/pay-qr?v=@payQrVersion" alt="@Text.PayQrAlt" width="256" height="256" />
    }
    <form method="post" asp-page-handler="PayQr" enctype="multipart/form-data">
        <div class="field">
            <label for="pay-qr-file">@Text.LogoChoose</label>
            <input type="file" id="pay-qr-file" name="picture" accept="image/png,image/jpeg,image/webp" required />
        </div>
        <button type="submit" class="secondary" data-confirm="@Text.PayQrSaveAsk">@Text.PayQrSave</button>
    </form>
    @if (Model.PayQrVersion is not null)
    {
        <form method="post" asp-page-handler="RemovePayQr" class="actions">
            <button type="submit" class="danger" data-confirm="@Text.PayQrRemoveAsk">@Text.PayQrRemove</button>
        </form>
    }
</div>

<div class="card">
    <h2>@Text.PlatformBackupTitle</h2>
    <p class="hint">@Text.PlatformBackupHint</p>
    @if (Model.BackupDaysSince is { } days)
    {
        <p class="@(Model.BackupOverdue ? "due" : "muted")">@Text.PlatformBackupLast(Model.BackupCopySavedAtUtc!.Value.ToString("MMM d, yyyy", invariant), days)@(Model.BackupOverdue ? " " + Text.PlatformBackupOverdue : "")</p>
    }
    else
    {
        <p class="warn">@Text.PlatformBackupNever</p>
    }
    <div class="actions">
        <a class="button secondary" href="@Model.BackupUrl" target="_blank" rel="noopener">@Text.PlatformBackupOpen</a>
        <form method="post" asp-page-handler="BackupSaved">
            <button type="submit" class="secondary" data-confirm="@Text.PlatformBackupAsk">@Text.PlatformBackupSaved</button>
        </form>
    </div>
</div>
