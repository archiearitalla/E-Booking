@page
@model VeskaFlow.Web.Pages.ErrorModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Text.ErrorTitle</title>
</head>
<body>
    <main>
        <h1>@Text.ErrorTitle</h1>
        <p>@Text.ErrorBody</p>
        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <p>@Text.ErrorRequestId: <code>@Model.RequestId</code></p>
        }
    </main>
</body>
</html>
