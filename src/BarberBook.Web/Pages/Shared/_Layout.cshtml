<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @Text.AppName</title>
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Head", required: false)
    <script src="~/js/site.js" defer></script>
</head>
<body data-theme="@BarberBook.Web.Services.BrandColors.Normalize(ViewData["Theme"] as string)">
    <a class="skip-link" href="#main">@Text.SkipToContent</a>
    <header class="site-header">
        <a class="brand" href="/">@Text.AppName</a>
        <nav aria-label="Main">
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.TrialEndsForBell(Context.Items) is { } trialEnds)
                {
                    var daysLeft = (int)Math.Ceiling((trialEnds - DateTime.UtcNow).TotalDays);
                    <details class="bell">
                        <summary aria-label="@Text.NotificationsLabel">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                            <span class="bell-badge@(daysLeft > 0 ? "" : " end")">@(daysLeft > 0 ? daysLeft.ToString() : "!")</span>
                        </summary>
                        <div class="bell-panel" role="status">
                            <strong>@Text.TrialTitle</strong>
                            <p>@(daysLeft > 0 ? string.Format(Text.TrialBanner, daysLeft) : Text.TrialEndedBanner)</p>
                        </div>
                    </details>
                }
                <a href="/Admin">@Text.NavDashboard</a>
                <form method="post" asp-page="/Logout" class="inline">
                    <button type="submit" class="link">@Text.NavSignOut</button>
                </form>
            }
            else
            {
                <a href="/Login">@Text.NavSignIn</a>
                <a href="/Register">@Text.NavRegister</a>
            }
        </nav>
    </header>
    <main class="container" id="main" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="site-footer">@Text.AppName v@(AppInfo.Version)</footer>
</body>
</html>
